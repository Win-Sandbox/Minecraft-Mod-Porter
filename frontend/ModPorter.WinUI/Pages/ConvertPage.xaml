<Page
    x:Class="ModPorter.WinUI.Pages.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="16" MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="版本转换" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="将模组源码工程从一个 Minecraft 版本转换到另一个版本。可用版本由后端映射数据库自动发现。"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <InfoBar x:Name="BackendBar" IsOpen="False" Severity="Error" IsClosable="False"/>

            <!-- 版本选择 -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <ComboBox x:Name="LoaderCombo" Grid.Column="0"
                          Header="加载器" HorizontalAlignment="Stretch"
                          SelectionChanged="LoaderCombo_SelectionChanged"/>
                <ComboBox x:Name="FromCombo" Grid.Column="1"
                          Header="源版本" HorizontalAlignment="Stretch"/>
                <FontIcon Grid.Column="2" Glyph="&#xE72A;" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                <ComboBox x:Name="ToCombo" Grid.Column="3"
                          Header="目标版本" HorizontalAlignment="Stretch"/>
            </Grid>

            <!-- 目录选择 -->
            <Grid ColumnSpacing="8" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBox x:Name="InputBox" Grid.Row="0" Grid.Column="0"
                         Header="输入工程目录" PlaceholderText="选择 1.x 模组源码工程根目录"/>
                <Button Grid.Row="0" Grid.Column="1" Content="浏览…"
                        VerticalAlignment="Bottom" Click="BrowseInput_Click"/>

                <TextBox x:Name="OutputBox" Grid.Row="1" Grid.Column="0"
                         Header="输出工程目录" PlaceholderText="转换结果输出目录（不能在输入目录内）"/>
                <Button Grid.Row="1" Grid.Column="1" Content="浏览…"
                        VerticalAlignment="Bottom" Click="BrowseOutput_Click"/>
            </Grid>

            <ToggleSwitch x:Name="DryRunToggle" Header="只分析不写出（dry-run）"
                          OnContent="开" OffContent="关"/>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ConvertButton" Style="{StaticResource AccentButtonStyle}"
                        Click="Convert_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14"/>
                        <TextBlock Text="开始转换"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshButton" Content="刷新版本列表" Click="Refresh_Click"/>
            </StackPanel>

            <!-- 进度 -->
            <ProgressBar x:Name="Progress" Visibility="Collapsed" Maximum="100"/>
            <TextBlock x:Name="ProgressText" Visibility="Collapsed"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- 结果 -->
            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Name="ViewReportButton" Content="查看报告" Click="ViewReport_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- 日志 -->
            <Expander x:Name="LogExpander" Header="转换日志" HorizontalAlignment="Stretch"
                      Visibility="Collapsed">
                <ListView x:Name="LogList" MaxHeight="320" SelectionMode="None"/>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
