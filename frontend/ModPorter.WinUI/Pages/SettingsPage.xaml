<Page
    x:Class="ModPorter.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}"/>

            <TextBox x:Name="JavaPathBox" Header="Java 可执行文件"
                     PlaceholderText="java（默认使用 PATH 中的 java，需 Java 17+）"/>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="JarPathBox" Grid.Column="0" Header="后端 modporter.jar 路径"
                         PlaceholderText="例如 D:\tools\mc-mod-porter\build\libs\mc-mod-porter-0.1.0.jar"/>
                <Button Grid.Column="1" Content="浏览…" VerticalAlignment="Bottom" Click="BrowseJar_Click"/>
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MappingsBox" Grid.Column="0" Header="映射数据目录（版本数据库）"
                         PlaceholderText="留空则使用后端默认（./mappings 或 MODPORTER_MAPPINGS）"/>
                <Button Grid.Column="1" Content="浏览…" VerticalAlignment="Bottom" Click="BrowseMappings_Click"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="保存" Style="{StaticResource AccentButtonStyle}" Click="Save_Click"/>
                <Button Content="测试后端连接" Click="Test_Click"/>
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>
