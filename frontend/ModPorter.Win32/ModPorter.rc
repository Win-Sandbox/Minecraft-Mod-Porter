#include <windows.h>
#include "resource.h"

// 视觉样式与 DPI 声明
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "ModPorter"
            VALUE "FileDescription",  "ModPorter - MC mod cross-version porter"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "ModPorter.Win32"
            VALUE "OriginalFilename", "ModPorter.exe"
            VALUE "ProductName",      "ModPorter"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
